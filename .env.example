# Zcash network the deployment runs on: testnet (default) or mainnet
NEXT_PUBLIC_ZEC_NETWORK=testnet

# Defaults: https://api.testnet.cipherpay.app (testnet) / https://api.cipherpay.app (mainnet)
CIPHERPAY_API_URL=

# --- Optional: live tracking for the site owner's OWN tip jar only. ---
# Never used as a default payee for anyone else. Creators paste their own key on /new instead.
# CipherPay merchant API keys (start with cpay_sk_). Server-side only; never exposed to the browser.
# On mainnet ONLY CIPHERPAY_API_KEY_MAINNET is read. On testnet: CIPHERPAY_API_KEY_TESTNET, or CIPHERPAY_API_KEY.
CIPHERPAY_API_KEY_MAINNET=
CIPHERPAY_API_KEY_TESTNET=
# Tip jar handle (without @) for the owner's own jar, e.g. miracuzzy
ZECLINK_OWNER_HANDLE=
# Optional: owner's shielded address on this network (direct tips when there's no key, or CipherPay is down)
ZECLINK_OWNER_ADDRESS=
