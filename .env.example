# Zcash network the deployment runs on: testnet (default) or mainnet
NEXT_PUBLIC_ZEC_NETWORK=testnet

# --- Live payment detection (optional). Leave empty => clearly-labelled DEMO MODE. ---
# CipherPay merchant API key (starts with cpay_sk_). Server-side only; never exposed to the browser.
CIPHERPAY_API_KEY=
# Defaults: https://api.testnet.cipherpay.app (testnet) / https://api.cipherpay.app (mainnet)
CIPHERPAY_API_URL=
