# Zcash network: mainnet (default)
NEXT_PUBLIC_ZEC_NETWORK=mainnet

# Default: https://api.cipherpay.app
CIPHERPAY_API_URL=

# --- Optional: live tracking for the site owner's OWN open-amount link only. ---
# Never used as a default payee for anyone else. Creators paste their own key on /new instead.
# CipherPay merchant API key (starts with cpay_sk_). Server-side only; never exposed to the browser.
CIPHERPAY_API_KEY_MAINNET=
# Handle (without @) for the owner's own link, e.g. miracuzzy
ZECLINK_OWNER_HANDLE=
# Optional: owner's shielded address (direct payments when there's no key, or CipherPay is down)
ZECLINK_OWNER_ADDRESS=
