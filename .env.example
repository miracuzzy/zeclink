# Zcash network the deployment runs on: testnet (default) or mainnet
NEXT_PUBLIC_ZEC_NETWORK=testnet

# Defaults: https://api.testnet.cipherpay.app (testnet) / https://api.cipherpay.app (mainnet)
CIPHERPAY_API_URL=

# --- Optional: live tracking for the site owner's OWN tip jar only. ---
# Never used as a default payee for anyone else. Creators paste their own key on /new instead.
# CipherPay merchant API key (starts with cpay_sk_). Server-side only; never exposed to the browser.
CIPHERPAY_API_KEY=
# Tip jar handle (without @) that may use CIPHERPAY_API_KEY, e.g. miracuzzy
ZECLINK_OWNER_HANDLE=
